# Copiar este archivo a .env (en desarrollo) o definir estas variables en Netlify.
# En producción, Nuxt reemplaza automáticamente runtimeConfig.public con estas variables.

# Clave pública de API de Snipcart (modo de prueba). NUNCA uses la clave secreta.
NUXT_PUBLIC_SNIPCART_API_KEY=tu_clave_publica_de_prueba

# Dirección pública del sitio (necesaria para que Snipcart valide cada compra).
NUXT_PUBLIC_SITE_URL=https://mi-sitio.netlify.app

# Repositorio de GitHub para los comentarios con Utterances (formato: usuario/repositorio).
NUXT_PUBLIC_UTTERANCES_REPO=tu-usuario/tu-repo
